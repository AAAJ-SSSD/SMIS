APP_NAME="School Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Application logs never receive personal data; login history lives in the audit log.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- SPA ----------------------------------------------------------------
# CORS, Sanctum stateful domain and post-login redirects all derive from this.
FRONTEND_URL=http://localhost:5173

# --- Login --------------------------------------------------------------
# Dev login only works when APP_ENV=local AND DEV_LOGIN_ENABLED=true.
DEV_LOGIN_ENABLED=true

# Google sign-in: active only when enabled AND client id/secret AND domain are set.
# If GOOGLE_LOGIN_ENABLED=true and SCHOOL_GOOGLE_DOMAIN is empty, the app refuses to start.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SCHOOL_GOOGLE_DOMAIN=

# Super-admin (seeded). Break-glass password + TOTP: `php artisan break-glass:setup`.
SUPER_ADMIN_EMAIL=
BREAK_GLASS_LOCK_MINUTES=30

# --- Database (MySQL 8 via Sail) ---------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=school
DB_USERNAME=sail
DB_PASSWORD=password

# --- Sessions (database driver so deactivation can end sessions) --------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
# Forced on automatically when APP_ENV=production.
SESSION_SECURE_COOKIE=false

# --- Cache + queues (Redis) ---------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Docker ports -------------------------------------------------------
APP_PORT=8000
FRONTEND_PORT=5173
